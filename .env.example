# URL base de la API del backend (Laravel). Se incrusta en el bundle en tiempo de build:
# nunca pongas aquí secretos, cualquier variable VITE_* es pública.
VITE_API_URL=http://localhost:8000/api

# Tiempo real (Laravel Reverb). Debe coincidir con REVERB_APP_KEY del backend;
# si se deja vacía, la app funciona con consultas periódicas (sin WebSocket).
VITE_REVERB_APP_KEY=

# Solo para desarrollo sin Docker (con `php artisan reverb:start` en el backend).
# En Docker se dejan vacías: el WebSocket usa el mismo host y puerto de la página.
VITE_REVERB_HOST=localhost
VITE_REVERB_PORT=8080
VITE_REVERB_SCHEME=http
